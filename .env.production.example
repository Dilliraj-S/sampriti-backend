# ─────────────────────────────────────────────────────────────────────────────
# Sampriti Backend — Production Environment (Hostinger)
# IMPORTANT: Fill in the real values before uploading this file to Hostinger.
#            Never commit this file to Git.
# ─────────────────────────────────────────────────────────────────────────────

# Database — fill from Hostinger hPanel → MySQL Databases
DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_HOSTINGER_DB_USERNAME
DB_PASS=YOUR_HOSTINGER_DB_PASSWORD
DB_NAME=YOUR_HOSTINGER_DB_NAME

# Server
PORT=5000
NODE_ENV=production

# Frontend (CORS origin)
FRONTEND_URL=https://sampritibotanicals.codespidey.com

# JWT secrets — generate strong random strings (64+ chars)
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=REPLACE_WITH_STRONG_64_CHAR_HEX_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_ANOTHER_STRONG_64_CHAR_HEX_SECRET

# Admin seed user (auto-created on first boot)
ADMIN_EMAIL=admin@sampritibotanicals.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Email (SMTP) — fill with your Hostinger or Gmail credentials
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USER=YOUR_HOSTINGER_EMAIL@yourdomain.com
MAIL_PASS=YOUR_HOSTINGER_EMAIL_PASSWORD
